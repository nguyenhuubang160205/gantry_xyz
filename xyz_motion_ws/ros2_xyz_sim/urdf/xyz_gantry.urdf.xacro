  <link name="base_table_top">
    <visual>
      <origin xyz="0.5 0.5 0.79" rpy="0 0 0"/>
      <geometry><box size="0.90 0.90 0.02"/></geometry>
      <material name="mat_silver"/>
    </visual>
    
    <visual>
      <origin xyz="0.5 0.35 0.801" rpy="0 0 0"/>
