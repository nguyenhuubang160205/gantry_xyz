  <joint name="joint_x" type="prismatic">
    <parent link="x_rail"/>
    <child link="x_carriage"/>
    <origin xyz="0.06 0.5 0.85" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.8" effort="1000.0" velocity="0.5"/>
    <dynamics damping="4.5" friction="3.5"/>
  </joint>
  <gazebo reference="joint_x">
    <implicitSpringDamper>1</implicitSpringDamper>
    <stopCfm>0.0</stopCfm>
    <stopErp>0.2</stopErp>
  </gazebo>

