  <!-- ==================================================================== -->
  <!-- 8. CỤM CẢM BIẾN GIA TỐC RUNG ĐẦU DAO (TOOL VIBRATION SENSOR @ 1000 Hz) -->
  <!-- Đề tài: TS. Nguyễn Hoàng Giáp - SVTH: Phan Anh Đức (2210806)         -->
  <!-- ==================================================================== -->
  <link name="tool_imu_sensor_link">
    <!-- Vỏ bọc nhôm Anodized vàng bảo vệ cảm biến gia tốc MEMS 3 trục gắn đầu dao -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.024 0.024 0.012"/></geometry>
      <material name="mat_gold"/>
    </visual>
    <!-- Chip cảm biến gia tốc vi cơ điện tử MEMS -->
    <visual>
      <origin xyz="0 0 0.007" rpy="0 0 0"/>
      <geometry><box size="0.008 0.008 0.002"/></geometry>
      <material name="mat_black"/>
    </visual>
    <!-- Đèn LED báo trạng thái cảm biến hoạt động thời gian thực -->
    <visual>
      <origin xyz="0.006 0.006 0.007" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0015" length="0.002"/></geometry>
      <material name="mat_green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.024 0.024 0.012"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000005" iyz="0" izz="0.000005"/>
    </inertial>
  </link>

  <!-- Khớp cố định gá cảm biến gia tốc trực tiếp tại đầu dao phay / Spindle Flange -->
  <joint name="z_tool_to_imu_sensor" type="fixed">
    <parent link="z_tool_flange"/>
    <child link="tool_imu_sensor_link"/>
    <origin xyz="0.12 0.038 -0.09" rpy="0 0 0"/>
  </joint>

  <!-- Plugin cảm biến gia tốc quán tính IMU Gazebo xuất topic /tool_imu/data @ 1000 Hz -->
  <gazebo reference="tool_imu_sensor_link">
    <material>Gazebo/Gold</material>
    <sensor name="tool_imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>1000.0</update_rate>
      <visualize>true</visualize>
      <topic>__default_topic__</topic>
      <plugin name="tool_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=tool_imu/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
      <imu>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.015</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.015</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.015</stddev>
            </noise>
          </z>
        </linear_acceleration>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001</stddev>
            </noise>
          </z>
        </angular_velocity>
      </imu>
    </sensor>
  </gazebo>

</robot>
