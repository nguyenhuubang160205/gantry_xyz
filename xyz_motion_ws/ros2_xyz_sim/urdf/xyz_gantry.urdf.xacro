      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.02"/>
    </inertial>
  </link>
  <gazebo reference="z_tool_flange">
    <material>Gazebo/Blue</material>
    <kp>10000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.0</maxVel>
    <surface>
      <contact>
        <collide_bitmask>0xffff</collide_bitmask>
        <ode>
          <kp>10000000.0</kp>
          <kd>100.0</kd>
          <min_depth>0.001</min_depth>
          <max_vel>0.0</max_vel>
        </ode>
      </contact>
      <friction>
        <ode>
          <mu>0.0</mu>
          <mu2>0.0</mu2>
        </ode>
      </friction>
    </surface>
    <sensor type="contact" name="probe_tip_contact">
      <always_on>true</always_on>
      <update_rate>1000.0</update_rate>
      <contact>
        <collision>probe_tip_collision</collision>
      </contact>
      <plugin name="probe_contact_plugin" filename="libgazebo_ros_contact_sensor.so">
      </plugin>
    </sensor>
