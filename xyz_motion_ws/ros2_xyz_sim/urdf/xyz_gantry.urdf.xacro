    <color rgba="0.90 0.72 0.20 1.0"/>
  </material>
  <material name="mat_orange">
    <color rgba="1.0 0.5 0.0 1.0"/>
  </material>
  <material name="mat_green">
    <color rgba="0.1 0.85 0.2 1.0"/>
  </material>

  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  
  <link name="base_link">
    
