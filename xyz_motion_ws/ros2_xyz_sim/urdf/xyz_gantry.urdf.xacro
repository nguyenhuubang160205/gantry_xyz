<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="xyz_gantry">

  <xacro:include filename="$(find ros2_xyz_sim)/urdf/xyz_gantry.ros2_control.xacro"/>

  <material name="mat_black">
    <color rgba="0.12 0.13 0.15 1.0"/>
  </material>
  <material name="mat_dark_grey">
    <color rgba="0.25 0.27 0.30 1.0"/>
  </material>
  <material name="mat_silver">
    <color rgba="0.82 0.85 0.88 1.0"/>
  </material>
  <material name="mat_chrome">
    <color rgba="0.94 0.96 0.98 1.0"/>
  </material>
  <material name="mat_blue">
    <color rgba="0.05 0.45 0.90 1.0"/>
  </material>
  <material name="mat_red">
    <color rgba="0.95 0.08 0.15 1.0"/>
  </material>
