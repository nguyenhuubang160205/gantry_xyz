      <geometry><cylinder radius="0.0022" length="0.085"/></geometry>
      <material name="mat_chrome"/>
    </visual>
    <!-- High-Contrast Helical Flute Edges (Visible dynamic spinning) -->
    <visual>
      <origin xyz="0 0 -0.185" rpy="0 0 0.785398"/>
      <geometry><box size="0.0055 0.0016 0.085"/></geometry>
      <material name="mat_silver"/>
