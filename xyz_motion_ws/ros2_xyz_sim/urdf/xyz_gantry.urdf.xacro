      <mass value="30.0"/>
      <inertia ixx="2.0" ixy="0" ixz="0" iyy="2.0" iyz="0" izz="4.0"/>
    </inertial>
  </link>
  <joint name="base_to_table_top" type="fixed">
    <parent link="base_link"/>
    <child link="base_table_top"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <gazebo reference="base_table_top">
    <material>Gazebo/Grey</material>
    <kp>10000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.0</maxVel>
    <surface>
      <contact>
        <collide_bitmask>0xffff</collide_bitmask>
        <ode>
          <kp>10000000.0</kp>
          <kd>100.0</kd>
          <min_depth>0.001</min_depth>
          <max_vel>0.0</max_vel>
        </ode>
      </contact>
      <friction>
        <ode>
          <mu>0.0</mu>
          <mu2>0.0</mu2>
        </ode>
      </friction>
    </surface>
  </gazebo>

  
