      <origin xyz="0.06 0 -0.02" rpy="0 0 0"/>
      <geometry><box size="0.14 0.10 0.18"/></geometry>
    </collision>
    <collision name="probe_tip_collision">
      <origin xyz="0.12 0 -0.23" rpy="0 0 0"/>
      <geometry><sphere radius="0.003"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.06 0 -0.02" rpy="0 0 0"/>
