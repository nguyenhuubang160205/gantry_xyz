<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="industrial_workspace">
    
    <!-- Physics parameters: 1000 Hz real-time step (1ms CSP) -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000.0</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.8</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Clean balanced scene with standard ground grid and soft lighting -->
    <scene>
      <ambient>0.5 0.5 0.5 1.0</ambient>
      <background>0.75 0.80 0.85 1.0</background>
      <shadows>false</shadows>
      <grid>true</grid>
    </scene>

    <!-- Gazebo GUI with dynamic CNC toolpath drawing plugin and angled top-down camera view -->
    <gui fullscreen='0'>
      <plugin name='gazebo_toolpath_plugin' filename='libgazebo_toolpath_plugin.so'/>
      <camera name='user_camera'>
        <pose>0.50 0.05 1.55 0 1.05 1.570796</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- Standard sun -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Standard ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Precision Machined Workpiece (400x400x100mm = 10cm thick) on Machine Table (Table Z=0.80m) -->
    <model name="machining_workpiece">
      <static>true</static>
      <pose>0.50 0.50 0.850 0 0 0</pose>
      <link name="workpiece_link">
        <!-- Main Workpiece Billet (400x400x100mm) - Top Surface at Z = 0.90m -->
        <visual name="workpiece_visual">
          <geometry>
            <box>
              <size>0.40 0.40 0.10</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>

        <!-- Coordinate Grid Surface Plate (Dark Slate with Oxy Grid) -->
        <visual name="workpiece_grid_plate">
          <pose>0 0 0.0501 0 0 0</pose>
          <geometry>
            <box>
              <size>0.398 0.398 0.0002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.15 0.18 1.0</ambient>
            <diffuse>0.18 0.22 0.26 1.0</diffuse>
          </material>
        </visual>

        <!-- Origin O(0,0,0) Marker (Gold Sphere at Top Corner of Workpiece) -->
        <visual name="origin_sphere">
          <pose>-0.20 -0.20 0.051 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.008</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.95 0.75 0.1 1.0</ambient>
            <diffuse>1.0 0.85 0.15 1.0</diffuse>
            <emissive>0.6 0.45 0.05 1.0</emissive>
          </material>
        </visual>

        <!-- +X Primary Axis Vector (Full Red Bar along X edge - 400mm) -->
        <visual name="axis_x_arrow">
          <pose>0 -0.20 0.051 0 1.570796 0</pose>
          <geometry>
            <cylinder>
              <radius>0.0025</radius>
              <length>0.40</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.95 0.1 0.1 1.0</ambient>
            <diffuse>1.0 0.15 0.15 1.0</diffuse>
            <emissive>0.7 0.05 0.05 1.0</emissive>
          </material>
        </visual>

        <!-- +Y Primary Axis Vector (Full Green Bar along Y edge - 400mm) -->
        <visual name="axis_y_arrow">
          <pose>-0.20 0 0.051 -1.570796 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.0025</radius>
              <length>0.40</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.9 0.2 1.0</ambient>
            <diffuse>0.15 1.0 0.25 1.0</diffuse>
            <emissive>0.05 0.6 0.1 1.0</emissive>
          </material>
        </visual>

        <!-- +Z Primary Axis Vector (Blue Column pointing up 200mm to Home Sensor Origin O(0,0,0)) -->
        <visual name="axis_z_home_line">
          <pose>-0.20 -0.20 0.151 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.0025</radius>
              <length>0.20</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.7 1.0 1.0</ambient>
            <diffuse>0.2 0.85 1.0 1.0</diffuse>
            <emissive>0.2 0.6 0.9 1.0</emissive>
          </material>
        </visual>

        <!-- Home Target Marker at Z = 0.0mm (20cm directly above workpiece corner) -->
        <visual name="home_target_marker">
          <pose>-0.20 -0.20 0.251 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.012</radius>
              <length>0.004</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.85 1.0 1.0</ambient>
            <diffuse>0.3 0.95 1.0 1.0</diffuse>
            <emissive>0.3 0.7 1.0 1.0</emissive>
          </material>
        </visual>

        <!-- Surface Grid Line X=100mm -->
        <visual name="grid_line_x100">
          <pose>-0.10 0 0.0503 -1.570796 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.0008</radius>
              <length>0.40</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.5 0.7 1.0</ambient>
            <diffuse>0.3 0.5 0.7 1.0</diffuse>
          </material>
        </visual>
        <!-- Surface Grid Line X=200mm -->
        <visual name="grid_line_x200">
          <pose>0 0 0.0503 -1.570796 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.0008</radius>
              <length>0.40</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.5 0.7 1.0</ambient>
            <diffuse>0.3 0.5 0.7 1.0</diffuse>
          </material>
        </visual>
        <!-- Surface Grid Line X=300mm -->
        <visual name="grid_line_x300">
          <pose>0.10 0 0.0503 -1.570796 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.0008</radius>
              <length>0.40</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.5 0.7 1.0</ambient>
            <diffuse>0.3 0.5 0.7 1.0</diffuse>
          </material>
        </visual>

        <!-- Surface Grid Line Y=100mm -->
        <visual name="grid_line_y100">
          <pose>0 -0.10 0.0503 0 1.570796 0</pose>
          <geometry>
            <cylinder>
              <radius>0.0008</radius>
              <length>0.40</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.5 0.7 1.0</ambient>
            <diffuse>0.3 0.5 0.7 1.0</diffuse>
          </material>
        </visual>
        <!-- Surface Grid Line Y=200mm -->
        <visual name="grid_line_y200">
          <pose>0 0 0.0503 0 1.570796 0</pose>
          <geometry>
            <cylinder>
              <radius>0.0008</radius>
              <length>0.40</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.5 0.7 1.0</ambient>
            <diffuse>0.3 0.5 0.7 1.0</diffuse>
          </material>
        </visual>
        <!-- Surface Grid Line Y=300mm -->
        <visual name="grid_line_y300">
          <pose>0 0.10 0.0503 0 1.570796 0</pose>
          <geometry>
            <cylinder>
              <radius>0.0008</radius>
              <length>0.40</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.5 0.7 1.0</ambient>
            <diffuse>0.3 0.5 0.7 1.0</diffuse>
          </material>
        </visual>

        <!-- Non-interfering Optical Workpiece Plane -->
        <collision name="workpiece_collision">
          <geometry>
            <box>
              <size>0.40 0.40 0.10</size>
            </box>
          </geometry>
          <surface>
            <contact>
              <collide_bitmask>0x0000</collide_bitmask>
              <ode>
                <kp>1000.0</kp>
                <kd>1.0</kd>
                <min_depth>0.001</min_depth>
                <max_vel>0.0</max_vel>
              </ode>
            </contact>
            <friction>
              <ode>
                <mu>0.0</mu>
                <mu2>0.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

  </world>
</sdf>
