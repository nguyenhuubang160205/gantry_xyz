	""
	""
	""
	""
#N0.78#########################################################################
DATA,120,"Numerator of external scale ratio",0,32767,0x10,2
	"Set the ratio of (encoder / external scale)."
	"Pr.78 = 0: Set Pr.7A to the external scale resolution per motor revolution."
	"Pr.78 > 0: Numerator = (Pr.78) x 2^(Pr.79)"
 	"The numerator is max. 131072, and over-setting is invalid."
#N0.79#########################################################################
DATA,121,"Multiplier of numerator of external scale ratio",0,17,0x10,2
	"Set the ratio of (encoder / external scale)."
	"Pr.78 = 0: This parameter is ignored."
	"Pr.78 > 0: Numerator = (Pr.78) x 2^(Pr.79)"
 	"The numerator is max. 131072, and over-setting is invalid."
#N0.7A#########################################################################
DATA,122,"Denominator of external scale ratio",1,32767,0x10,2
	"Set the ratio of (encoder / external scale)."
	"Pr.78 = 0: Set this parameter to the external scale resolution per motor revolution."
	"Pr.78 > 0: Set this parameter to the denominator."
 	""
#N0.7B#########################################################################
DATA,123,"Hybrid deviation error level",1,10000,0x10,2
	"Set the tolerance of actual position gap between the encoder and the external scale."
	"Unit: [16 x pulse] based on the external scale"
	""
	""
#N0.7C#########################################################################
DATA,124,"External scale direction",0,1,0x10,2
	"Select polarity of the absolute data of the external scale."
	"When the detection head moves to right (viewed from the installing side),"
	"0: Data increases (+)."
 	"1: Data decreases (-)."
#N0.7D#########################################################################
DATA,125,"Absolute external scale setup",0,1,0x10,2
	"Select the using method of the absolute external scale."
	"0: Used as absolute"
 	"1: Used as incremental"
	"Normally, set to 0."
