DATA,21,"+A ","- "
DATA,22,"+A ","- "
DATA,23,"+A ","- "
DATA,24,"+A ","- "
DATA,25,"+A ","- "
DATA,26,"+A ","- "
DATA,27,"+A ","- "
DATA,28,"+A ","- "
DATA,29,"+A ","- "
DATA,30,"+A ","- "
DATA,31,"+A ","- "
END
