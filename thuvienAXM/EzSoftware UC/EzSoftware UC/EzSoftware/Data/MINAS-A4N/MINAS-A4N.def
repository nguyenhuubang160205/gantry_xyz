############################################
#Version of the file
############################################
FILE VERSION,1
DATA,1,Series basic file,"3.70.01"
END
############################################
#Version of this software
############################################
VERSION,1
DATA,0
	0x103F		,#function control(when driver is connected via 232)
	0x143F		,#function control(when driver is connected via 485)
	0x1134		,#function control(when no driver is connects)
#Bit0:Monitor.Bit1:Alarm.Bit2:Parameter.Bit3:Auto tuning
#Bit4:Wave form graphic.Bit5:Frequency characteristics
#Bit6:Positioning Parameter
#Bit7:Positioning Monitor
#Bit8:Model selection.Bit9:Communication control. Bit10:Axis setting. Bit11:Password.Bit12:Port selection
#Bit14:Log window. Bit15:Control window
END
############################################
#バージョン３．７での追加事項：通信速度拡張
############################################
EXTENTION V3.7,1
DATA,0,6	,#ＣＯＭ通信速度の個数
#	115200	,#通信速度
	9600	,#通信速度
	57600	,#通信速度
	38400	,#通信速度
	19200	,#通信速度
	4800	,#通信速度
	2400	,#通信速度
END
############################################
#バージョン３．６拡張機能の制御
############################################
EXTENTION V3.6,1
#Max value of Machine Stiffness at Auto-Tuning Screen.
DATA,1,15
END
############################################
#バージョン３．５拡張機能の制御
############################################
EXTENTION V3.5,1
DATA,0
####
#ＦＦＴ測定条件のフルクローズの有無（機種毎に異なる）
#０：なし　　１：あり
0,
####
#デフォルトのＦＦＴ測定条件のフルクローズ
#０：チェックＯＦＦ（モータ速度）
#１：チェックＯＮ　（外部スケール速度）
0,
####
#３２ビットパラメータ使用の有無（機種毎に異なる）
#０：使用しない　　１：使用する
0,
####
#３２ビットパラメータ先頭値
0,
####
#３２ビットユーザーパラメータの個数
0,
####
#３２ビットパラメータの個数（ユーザー＋システム）
0
END
###################################################
#バージョン3.0での変更
###################################################
############################################
#測定項目の種類と表示許可
############################################
MEASURE ITEM,6
#	Name					DspName			unit		Comment										Enable/Disable-CheckBox
DATA,0,"Actual speed",		"Act speed",	"[r/min]",	"Set the actual speed measurement or not.",	1,	# Actual Speed
DATA,1,"Torque",			"Torque",		"[%]",		"Set the torque measurement or not."		1,	# Torque
DATA,2,"Position error",	"P-Error",		"[pulse]",	"Set the position error measurement or not.",	1,	# Pos Error
DATA,3,"Command speed",		"Cmd speed",	"[r/min]",	"Set the commanded speed measurement or not.",	1,	# Cmd Speed
DATA,4,"Full-closed error",	"F-Error",		"[pulse]",	"Set the full-closed error measurement or not.",	1,	# F-closed Error
DATA,5,"In-position",		"INP",			"[ON/OFF]",	"Set the in-position measurement or not.",	1,	# In-position
DATA,6,"Reserved",			"rsv",			"[none]",	"Not used.",								0,	# Not used
END
############################################
#バージョン３．０拡張機能の制御
############################################
EXTENTION V3.0,1
DATA,0
#####
#ポジショニング関連処理のＯＮ／ＯＦＦ
#（設定すると、起動時にポジショニングパラメータのデフォルト値を読込ます）
#１：ポジショニングモニタ、ポジショニングパラメータを利用する
#０：ポジショニングモニタ、ポジショニングパラメータを利用しない
0,	
#####
#波形グラフィックで、５項目から３項目選択して測定する機能の有無
#０：ＯＦＦ
#１：ＯＮ
1,
#####
3,	#測定項目の最大同時選択数
#####
4,	#位置決め完了でチェックするビット（該当ビットをＯＮにした整数を設定）
#####
0,	#ステップ数の先頭値
16,	#ステップ数（ユーザー）の個数
16,	#ステップ数（ユーザー＋システム）の個数
#####
0,	#１６ビットポジショニングパラメータの先頭値
0x38,	#１６ビットポジショニングパラメータ（ユーザー）の個数
0x40,	#１６ビットポジショニングパラメータ（ユーザー＋システム）の個数
#####
0,	#３２ビットポジショニングパラメータの先頭値
4,	#３２ビットポジショニングパラメータ（ユーザー）の個数
4,	#３２ビットポジショニングパラメータ（ユーザー＋システム）の個数
#####
-2147483648,	#ステップ位置最小値
2147483647,	#ステップ位置最大値
#####
"Set the measuring item.(can set max 3 items.)",	#測定項目フレームのツールチップテキスト
#####
END
############################################
#Serial port setting(to be reset at model setting)
############################################
COM PORT,1
DATA,0
	1	,#Port No.
	9600	,#Baud rate
#Time out setting at normal communication
	500	,#Time out 1
	10000	,#Time out 2
	2	,#Retry times
#Time out setting at axis scanning
	500	,#Time out 1
	10000	,#Time out 2
	2	,#Retry times
#Time out setting at model scanning(Setting at Default.def can be used in this setting.)
	500	,#Time out 1
	10000	,#Time out 2
	2	,#Retry times
#Time out setting at auto tuning complete scanning(can't be used for MSDA series.)
	500	,#Time out 1
	10000	,#Time out 2
	1	,#Retry times
END
############################################
#Numbers (of such as parameter)
############################################
MAX ITEM,1
DATA,0
	0xff		,#Max. item numbers
	0x80		,#User parameters
	0x80		,#System parameters
	0x80		,#System parameter-starting address
	0xB8		,#Max. parameters to be checked at writing to EEPROM
	32		,#I/O parameters
	14		,#Alarm display items
	14		,#Alarm time display items
	0x5F		,# Heading upper digit of parameter at Intel Hex file
	2048		,#FFT points of default	
	50		,#FFT measurement amplitudes of default
	0		,#FFT measurement offsets of dafault
	1		,#FFT measurement sampling rate of default
 	1000.00	,#Max.display frequency of frequency characteristics graph
	0.0001666	,#FFT sampling unit(s)	
	0.0001666	,#Wave form graphic sampling unit (s)
	1 ,#Simultaneous measurement of multiple items at wave form graphic(1 for MSDA)
	1		,# Display of control mode
	1		,# Display of 1st. page of I/O
	1		,# Display of 2nd. page of I/O
	1		,# Display of load page
	1		,# Display of absolute page on the screen ?
	1		,# Display of clear on absolute page
	1		,# Display of the current time
	-5000		,# Lower trigger limit of wave form graphic
	5000		,# Upper trigger limit of wave form graphic
	1 ,# Issuance of command obtaining execution right at writing or measuring
	2		,# Auto tuning command selection0:X 1:Z 2:A
	20		,# Dividing value of torque at display
END
############################################
#Parameter control information
############################################
PARA MENU,255
#N0.00#########################################################################
DATA,0		,#番号
	"For manufacturer use"	,#名称
	1	,#最小値
	1	,#最大値
	0x100	,#属性
	2	,#タイプ	Bit1:ゲイン調整で使用して良い　Bit0:ゲイン調整で使用する
	""
	""
	""
	""
#N0.01#########################################################################
DATA,1,"LED display",0,4,0x00,2
	"Select the data to be displayed on 7-segment LED of the front panel."
	"0: Normal display, 1: Mechanical angle (0 - FF[hex]), 0 indicates zero position of the encoder."
	"2: Electrical angle (0 - FF[hex]), 0 indicates the peak point of U-phase back-EMF."
	"3: Cumulative communication error count (0 - FF[hex]), 4: Node address (MAC-ID) in decimal"
#N0.02#########################################################################
DATA,2,"Control mode",0,6,0x10,2
	"Select the control mode."
	"0: Position"
	"1-5: Do not use"
	"6: Full-closed"
#N0.03#########################################################################
DATA,3,"Torque limit selection",1,3,0,2
	"Define the parameter for setting the torque limit."
	"1: CW and CCW are set with Pr.5E. (CW and CCW are the same.)"
	"2: CW Pr.5E / CCW Pr.5F"
 	"3: When TL SW of network command is '0'/'1', Pr.5E/Pr.5F. (CW and CCW are the same.)"
#N0.04#########################################################################
DATA,4,"Overtravel input inhibit",0,2,0x10,2
	"Set the function of CW overtravel input (CWL) and CCW overtravel input (CCWL)."
 	"0: Overtravel input enabled (Refer to Pr.66)"
	"1: Overtravel input disabled (However, CWL/CCWL can be monitored via network.)"
	"2: If CWL or CCWL is opened, Overtravel inhibit input error occurs."
#N0.05#########################################################################
DATA,5,"For manufacturer use",0,2,0,2
	""
	""
	""
	""
#N0.06#########################################################################
DATA,6,"Address indicated time at power-up",0,1000,0x10,2
	"Set time for indicating the node address at control power-up."
	"0-6: 600[ms]"
	"7-1000: Setting value x 100[ms]"
	""
#N0.07#########################################################################
DATA,7,"Speed monitor (SP) selection",0,11,0,2
	"Select the analog speed monitor (SP) output. ( ) represents the monitor value at approx. 6V."
	"0-4: Actual speed (0: 47, 1: 188, 2: 750, 3: 3000, 4: 12000[r/min])"
	"5-9: Command speed (5: 47, 6: 188, 7: 750, 8: 3000, 9: 12000[r/min])"
	"10: Position command (0V: Active, 5V: None), 11: Gain switching (0V: 2nd gain, 5V: 1st gain)"
#N0.08#########################################################################
DATA,8,"Torque monitor (IM) selection",0,14,0,2
	"Select the analog torque monitor (IM) output. ( ) represents the monitor value at approx. 3V."
	"0: TRQ command (100[%]), 11: TRQ command (200[%]), 12: TRQ command (300[%])"
	"1-5: Position deviation (1: 31, 2: 125, 3: 500, 4: 2000, 5: 8000[pulse])"
	"6-10: Full-closed deviation (6: 31, 7: 125, 8: 500, 9: 2000, 10: 8000[pulse])"
#N0.09#########################################################################
DATA,9,"Unit of velocity",0,2,0,2
	"Select the unit of the velocity via network."
	"0: r/min (based on encoder)"
	"1: pulse/s (based on encoder)"
	"2: pulse/s (based on external scale in full-closed control, or encoder in position control)"
#N0.0A#########################################################################
DATA,10,"Inhibit parameter change via network",0,1,0,2
	"Inhibits the parameter change via network."
	"If this parameter is 1 (inhibit) and the host controller commands to change parameter,"
	"command error is replied."
	"0: Not inhibit, 1: Inhibit"
#N0.0B#########################################################################
DATA,11,"Absolute encoder setup",0,2,0x10,2
	"Select the using method of the absolute encoder."
	"0: Used as absolute."
 	"1: Used as incremental."
	"2: Used as absolute neglecting the counter over error. "
#N0.0C#########################################################################
DATA,12,"Baud rate of RS232",0,5,0x10,2
	"Set the communication speed of RS232."
	"0: 2400[bps],  1: 4800[bps]"
 	"2: 9600[bps],  3: 19200[bps]"
	"4: 38400[bps], 5: 57600[bps]"
#N0.0D#########################################################################
DATA,13,"Warning setup of cumulative COM error",0,32767,0x00,2
	"If the number of cumulative communication errors is this parameter value or more, "
	"warning No.84 occurs."
	"When this parameter is set to 0, this function is disabled and the warning does not occur."
	""
#N0.0E#########################################################################
DATA,14,"Warning setup of continuous COM error",0,32767,0x00,2
	"If the number of continuous communication errors is this parameter value or more, "
	"warning No.83 occurs."
	"When this parameter is set to 0, this function is disabled and the warning does not occur."
	"The maximum value depends on the number for detecting Err.83"
#N0.0F#########################################################################
DATA,15,"Update counter warning setup",0,32767,0x00,2
	"If the update counter is not incremented properly and this situation continues "
	"for this parameter value, warning No.86 occurs."
	"Normally, this parameter should be set to 0 (disable)."
	""
#N0.10#########################################################################
DATA,16,"1st position loop gain",0,3000,0,2
	"Set the position loop gain."
 	"Unit: [1/s]"
	"Larger value yields larger stiffness of the servo and faster in-position."
	"Note that too large setting may result in oscillation."
#N0.11#########################################################################
DATA,17,"1st velocity loop gain",1,3500,0,2
	"Set the velocity loop gain."
	"When the inertia ratio is set correctly at Pr.20, the unit is [Hz]."
	"Larger value yields quicker velocity response, however, may cause oscillation."
 	""
#N0.12#########################################################################
DATA,18,"1st velocity loop integration time constant",1,1000,0,2
	"Set the time constant of velocity integration."
	"Smaller value yields faster integration. Unit: [ms]"
	"1-998: Integration enabled,  999: Integration disabled with holding integrated value"
	"1000 : Integration disabled"
#N0.13#########################################################################
DATA,19,"1st speed detection filter",0,5,0,2
	"Select the velocity detection filter."
	"Larger value reduces noise from the motor, however, the response becomes lower."
	"Normally, 0 is recommended."
	""
#N0.14#########################################################################
DATA,20,"1st torque filter time constant",0,2500,0,2
	"Set the time constant of the 1st order lag filter added to the torque command."
	"Unit: [0.01ms]"
	"With this setting, machine vibration may be reduced."
	"If there is no resonance, smaller value yields quicker response time."
#N0.15#########################################################################
DATA,21,"Velocity feed forward",-2000,2000,0,2
	"Set the velocity feed forward gain."
	"Unit: [0.1%]"
	"Use this when extremely quicker response is required."
 	""
#N0.16#########################################################################
DATA,22,"Feed forward filter time constant",0,6400,0,2
	"Set the time constant of the 1st order lag filter added to the velocity feed forward."
	"Unit: [0.01ms]"
	""
 	""
#N0.17#########################################################################
DATA,23,"For manufacturer use",-32768,32767,0x80,2
	""
	""
	""
 	""
#N0.18#########################################################################
DATA,24,"2nd position loop gain",0,3000,0,2
	"This parameter has the same function as Pr.10, and is only for the gain switching."
	"When using the gain switching, Pr.30-35 must be also set."
	""
	""
#N0.19#########################################################################
DATA,25,"2nd velocity loop gain",1,3500,0,2
	"This parameter has the same function as Pr.11, and is only for the gain switching."
	"When using the gain switching, Pr.30-35 must be also set."
	""
 	""
#N0.1A#########################################################################
DATA,26,"2nd velocity loop integration time constant",1,1000,0,2
	"This parameter has the same function as Pr.12, and is only for the gain switching."
	"When using the gain switching, Pr.30-35 must be also set."
	""
 	""
#N0.1B#########################################################################
DATA,27,"2nd speed detection filter",0,5,0,2
	"This parameter has the same function as Pr.13, and is only for the gain switching."
	"When using the gain switching, Pr.30-35 must be also set."
	""
 	""
#N0.1C#########################################################################
DATA,28,"2nd torque filter time constant",0,2500,0,2
	"This parameter has the same function as Pr.14, and is only for the gain switching."
	"When using the gain switching, Pr.30-35 must be also set."
	""
 	""
#N0.1D#########################################################################
DATA,29,"1st notch frequency",100,1500,0,2
	"Set the 1st notch frequency of the resonance suppression filter. Unit: [Hz]"
	"This frequency should be coincident with the resonance frequency of the machine."
	"100-1499: Filter enabled"
	"1500: Filter disabled"
#N0.1E#########################################################################
DATA,30,"1st notch width selection",0,4,0,2
	"Select the 1st notch width of the resonance suppression filter."
	"Larger value makes wider notch width."
	"Normally, set to 2."
 	""
#N0.1F#########################################################################
DATA,31,"For manufacturer use",-32768,32767,0x80,2
	""
	""
	""
 	""
#N0.20#########################################################################
DATA,32,"Inertia ratio",0,10000,0,3
	"Set the ratio of load inertia to rotor inertia of the motor."
	"Unit: [%]"
	"Setting value = (Load inertia / Rotor inertia) x 100"
 	""
#N0.21#########################################################################
DATA,33,"Real-time auto tuning setup",0,7,0,3
	"Defines the operation mode of the real-time auto tuning (RAT)."
	"0: RAT disabled,  1-3: RAT enabled as normal mode"
	"4-6: RAT enabled as vertical axis mode"
	"7: RAT enabled without the gain switching function"
#N0.22#########################################################################
DATA,34,"Machine stiffness at auto tuning",0,15,0,3
	"Set the machine stiffness at the real-time auto tuning."
	"Larger value makes quicker response."
	"Because sudden increase of this parameter may shock the machine, "
	"start with smaller value and increase gradually."
#N0.23#########################################################################
DATA,35,"Adaptive filter mode",0,2,0,2
	"Enables the adaptive notch filter."
	"0: Disable (Pr.2F becomes 0)"
	"1: Enable"
	"2: Hold (When set to 2, the frequency of the filter is held)"
#N0.24#########################################################################
DATA,36,"Vibration suppression filter selection",0,5,0x10,2
	"Select the type and the switching method of vibration suppression filter."
	"0-2: Normal type (10 to 200Hz), 3-5: Range extended (1 to 200Hz, Adaptive filter disabled)"
	"0, 1, 3, 4: No switching (1st and 2nd are both enabled)"
	"2, 5: Switch by the command direction (CCW: 1st, CW: 2nd)"
#N0.25#########################################################################
DATA,37,"Normal auto tuning motion setup",0,7,0,2
	"Select the motion pattern (direction and revolutions) of the normal mode auto tuning."
	"0: 2 CCW / 2 CW,   1: 2 CW / 2 CCW,   2: 2 CCW / 2 CCW,   3: 2 CW / 2 CW"
	"4: 1 CCW / 1 CW,   5: 1 CW / 1 CCW,   6: 1 CCW / 1 CCW,   7: 1 CW / 1 CW"
	"(e.g.) If 0, one cycle consists of the first 2 CCW and secondly 2 CW revolutions."
#N0.26#########################################################################
DATA,38,"Software limit setup",0,1000,0,2
	"Set the value of allowable over-revolution based on the position commanded range."
	"Unit: [0.1rev.]"
 	"When set to 0, the software limit error is not detected."
	""
#N0.27#########################################################################
DATA,39,"Velocity observer",0,1,0,2
	"Enables the instantaneous velocity observer."
	"0: Disable"
	"1: Enable"
	""
#N0.28#########################################################################
DATA,40,"2nd notch frequency",100,1500,0,2
	"Set the 2nd notch frequency of the resonance suppression filter. Unit: [Hz]"
	"This frequency should be coincident with the resonance frequency of the machine."
	"100-1499: Filter enabled"
	"1500: Filter disabled"
#N0.29#########################################################################
DATA,41,"2nd notch width selection",0,4,0,2
	"Select the 2nd notch width of the resonance suppression filter."
	"Larger value makes wider notch width."
	"Normally, set to 2."
 	""
#N0.2A#########################################################################
DATA,42,"2nd notch depth selection",0,99,0,2
	"Set the 2nd notch depth of the resonance suppression filter."
	"Increasing the setting value reduces the notch depth and the phase delay."
	""
 	""
#N0.2B#########################################################################
DATA,43,"1st vibration suppression frequency",0,2000,0,2
	"Set the 1st vibration suppression frequency."
	"Unit: [0.1Hz] The setting range depends on Pr.24."
	"When Pr.24 is 0-2 (normal type),     0-99: Disable, 100-2000: Enable"
	"When Pr.24 is 3-5 (range extended),   0-9: Disable,  10-2000: Enable"
#N0.2C#########################################################################
DATA,44,"1st vibration suppression filter",-200,2000,0,2
	"Set the 1st vibration suppression filter."
	"Unit: [0.1Hz] Normally, set to 0."
 	"Increasing the setting value makes the settling time short, "
	"however, if torque saturation occurs, decrease the setting value."
#N0.2D#########################################################################
DATA,45,"2nd vibration suppression frequency",0,2000,0,2
	"Set the 2nd vibration suppression frequency."
	"Unit: [0.1Hz] The setting range depends on Pr.24."
	"When Pr.24 is 0-2 (normal type),     0-99: Disable, 100-2000: Enable"
	"When Pr.24 is 3-5 (range extended),   0-9: Disable,  10-2000: Enable"
#N0.2E#########################################################################
DATA,46,"2nd vibration suppression filter",-200,2000,0,2
	"Set the 2nd vibration suppression filter."
	"Unit: [0.1Hz] Normally, set to 0."
 	"Increasing the setting value makes the settling time short, "
	"however, if torque saturation occurs, decrease the setting value."
#N0.2F#########################################################################
DATA,47,"Adaptive filter frequency",0,64,0x100,2
	"Indicates the table number corresponding to the notch frequency of the adaptive filter."
	"When Pr.23 is set to 1, this parameter is automatically set and you cannot modify."
	"0-4: Filter disabled,  5-48: Filter enabled"
	"49-64: Filter enabling depends on Pr.22"
#N0.30#########################################################################
DATA,48,"2nd gain action setup",0,1,0,2
	"When using the gain switching function, set this parameter to 1."
	"0: Only 1st gain (Pr.10-14)"
	"1: Switch the 1st gain (Pr.10-14) and 2nd gain (Pr.18-1C)"
	""
#N0.31#########################################################################
DATA,49,"Gain switching mode",0,10,0,2
	"Select the trigger for the gain switching."
	"0: 1st gain fixed, 1: 2nd gain fixed, 2: Gain SW bit of network command, "
	"3: Torque command, 4: 1st gain fixed, 5: Velocity command, 6: Position deviation,"
	"7: Position command, 8: Not in-position, 9: Velocity, 10: Position command and velocity."
#N0.32#########################################################################
DATA,50,"Gain switching delay time",0,10000,0,2
	"When Pr.31 is set to 3 or 5-10, "
	"set the delay time between the trigger detection and switching gain from 2nd to 1st."
	"Unit: [0.166ms]"
 	""
#N0.33#########################################################################
DATA,51,"Gain switching level",0,20000,0,2
	"When Pr.31 is set to 3, 5, 6, 9, or 10, set the trigger level."
	"Unit depends on Pr.31."
	""
 	""
#N0.34#########################################################################
DATA,52,"Gain switching hysteresis",0,20000,0,2
	"When Pr.31 is set to 3, 5, 6, 9, or 10, set the hysteresis for trigger judgment."
	"Unit depends on Pr.31."
 	""
	""
#N0.35#########################################################################
DATA,53,"Position loop gain switching time",0,10000,0,2
	"Suppresses the sudden increase of the position loop gain, "
	"when there is a big difference between 1st and 2nd gain."
 	"Position loop gain increases for the period of (setting value + 1) x 0.166[ms]."
	"In decrease case, this parameter is not applied."
#N0.36#########################################################################
DATA,54,"For manufacturer use",-32768,32767,0x80,2
	""
