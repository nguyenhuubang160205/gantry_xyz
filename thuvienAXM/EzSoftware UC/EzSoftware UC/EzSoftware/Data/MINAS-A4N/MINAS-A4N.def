############################################
#Positioning Input terminals
############################################
POS IN NAME,31
DATA, 0X0, +A POS Servo-ON, - POS Servo-ON
DATA, 0x1, +A POS Alarm Clear, - POS Alarm Clear
DATA, 2, +A CW Overtravel Inhibit, - CW Overtravel Inhibit
DATA, 3, +A CCW Overtravel Inhibit, - CCW Overtravel Inhibit
DATA, 4, +A Homing Strobe, - Homing Strobe
DATA, 5, -  Stop signal, +A Stop signal
DATA, 6, +A Jog forward, - Jog forward
DATA, 7, +A Jog backward, - Jog backward
DATA, 8, +A P1, - P1
DATA, 9, +A P2, - P2
DATA, 10, +A P4, - P4
DATA, 11, +A P8 , - P8
DATA, 12, +A P16, - P16
DATA, 13, +A P32, - P32
DATA, 14, +A P64 ,- P64
DATA, 15, +A Step strobe, - Step strobe
DATA, 16, +A Z-LS , - Z-LS
DATA, 17, - , -
DATA, 18, - , -
DATA, 19, - , -
