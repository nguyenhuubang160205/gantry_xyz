DATA,94,"1st torque limit",0,500,0,2
	"Set the 1st limit of the motor output torque."
	"Unit: [%]"
	"For the use of this parameter, refer to Pr.03."
 	""
#N0.5F#########################################################################
DATA,95,"2nd torque limit",0,500,0,2
	"Set the 2nd limit of the motor output torque."
	"Unit: [%]"
	"For the use of this parameter, refer to Pr.03."
 	""
#N0.60#########################################################################
DATA,96,"In-position range",0,32767,0,2
	"Set the allowable pulses for in-position judgment, which is basically, "
	"whether the position deviation is within this setting. Refer to Pr.63."
	"The unit is resolution [pulse] of either the encoder in position control, "
 	"or the external scale in full-closed control."
#N0.61#########################################################################
DATA,97,"Zero speed",10,20000,0,2
	"Set the threshold level of the zero speed detection."
 	"When the speed is lower than this setting, Zero speed is detected."
	"Unit: [r/min]"
	"This detection has hysteresis of 10[r/min]."
#N0.62#########################################################################
DATA,98,"For manufacturer use",-32768,32767,0x80,2
	""
	""
	""
	""
#N0.63#########################################################################
DATA,99,"In-position output setup",0,3,0,2
	"Select the conditions for activating in-position output signal."
	"0: Position deviation within in-pos. range. 1: Condition 0 and no position command."
 	"2: Condition 1 and zero speed detection."
 	"3: Condition 1 with holding ON state until the next position command."
#N0.64#########################################################################
DATA,100,"CT-offset re-calibration at servo-on",0,1,0,2
	"Enables the re-calibration to cancel the CT-offset at turning servo on."
	"0: Disable (Only at power-up, calibrated)"
	"1: Enable (At both power-up and servo-on, calibrated)"
 	""
#N0.65#########################################################################
DATA,101,"Undervoltage error response at main power-off",0,1,0,2
	"Select the action when the main power-off is detected during servo-on."
	"0: Turn servo off according to Pr.67. "
	"   After that, if the power is turned on, the drive will be servo-on again."
	"1: Trip as the undervoltage error (Err.13)."
#N0.66#########################################################################
DATA,102,"Error response at overtravel limit",0,2,0x10,2
	"Select the sequence at overtravel."
	"0: Using dynamic brake, stop. After that, torque zero for the limit direction."
	"1: Using servo free, stop. After that, torque zero for the limit direction."
	"2: Using servo lock, stop. After that, servo lock for the limit direction."
#N0.67#########################################################################
DATA,103,"Error response at main power-off",0,9,0,2
	"Select the sequence at the main power-off when Pr.65 is 0. "
	"<in slow down  / after stop / pos. deviation>, (DB: dynamic brake, F: servo free, CLR: clear)"
	"0, 4: <DB / DB / CLR>,   1, 5: <F / DB / CLR>,   2, 6: <DB / F / CLR>"
	"3, 7: <F / F / CLR>,   8: <Servo-lock / DB / CLR>,   9: <Servo-lock / F / CLR>"
#N0.68#########################################################################
DATA,104,"Error response action",0,3,0,2
	"Select the sequence at alarm."
	"<in slow down  / after stop / pos. deviation>, (DB: dynamic brake, F: servo free, CLR: clear)"
	"0: <DB / DB / CLR>,   1: <F / DB / CLR>,   2: <DB / F / CLR>,   3: <F / F / CLR>"
	"Note that the position deviation is cleared when alarm is released."
#N0.69#########################################################################
DATA,105,"Sequence at servo-off",0,9,0,2
	"Select the sequence at servo-off."
	"<in slow down  / after stop / pos. deviation>, (DB: dynamic brake, F: servo free, CLR: clear)"
	"0, 4: <DB / DB / CLR>,   1, 5: <F / DB / CLR>,   2, 6: <DB / F / CLR>"
	"3, 7: <F / F / CLR>,   8: <Servo-lock / DB / CLR>,   9: <Servo-lock / F / CLR>"
#N0.6A#########################################################################
DATA,106,"Mechanical brake delay at motor standstill",0,100,0,2
	"Set the time from BRK-OFF output open (i.e. braking) to servo-off"
	"when you turn servo off at motor standstill (servo-locked)."
	"Unit: [2ms]"
 	""
#N0.6B#########################################################################
DATA,107,"Mechanical brake delay at motor in motion",0,100,0,2
	"Set the time from servo-off to BRK-OFF output open (i.e. braking)"
	"when you turn servo off at motor in motion. "
	"Unit: [2ms]"
	"If velocity is reduced to 30 r/min or less before the setting time, BRK-OFF is forced open."
#N0.6C#########################################################################
DATA,108,"External regenerative resistor setup",0,3,0x10,2
	"Select the operation of the regenerative discharge resistor and its overload protection."
	"0: Internal resistor with protection"
	"1: External resistor with protection, which is activated if the operating rate exceeds 10 %."
 	"2: External resistor without protection,   3: Resistor not used"
#N0.6D#########################################################################
DATA,109,"Main power-off detection time",35,1000,0x10,2
	"Set the time from the main power shut down to the power-off judgment."
	"Unit: [2ms]"
	"When set to 1000, the main power-off is not detected."
 	""
#N0.6E#########################################################################
DATA,110,"Emergency stop torque setup",0,500,0,2
	"Set the torque limit during the deceleration in the following case."
	"Pr.66 = 2, Pr.67 = 8 or 9, Pr.69 = 8 or 9"
	"Unit: [%]"
	"When set to 0, the normal torque limit is used."
#N0.6F#########################################################################
DATA,111,"For manufacturer use",-32768,32767,0x80,2
	""
	""
	""
 	""
#N0.70#########################################################################
DATA,112,"Position deviation error level",0,32767,0,2
	"If the position deviation exceeds this setting, the error is detected."
	"Unit is [256 x resolution] of encoder in position control, "
 	"or of external scale in full-closed control."
	"When set to 0, the error is not detected."
#N0.71#########################################################################
DATA,113,"For manufacturer use",0,100,0,2
	""
	""
	""
	""
#N0.72#########################################################################
DATA,114,"Overload level",0,500,0,2
	"Set the detection level of the overload protection. The unit is [%] based on the rated torque."
 	"This parameter is limited to 115[%]."
	"When set to 0, the level is 115[%]."
	"Normally, set to 0 except to need level down."
#N0.73#########################################################################
DATA,115,"Overspeed level",0,20000,0,2
	"Set the detection level of the overspeed protection. Unit: [r/min]"
 	"This parameter is limited to (Max. motor speed x 1.2)."
	"When set to 0, the level is (Max. motor speed x 1.2)."
	"Normally, set to 0 except to need level down."
#N0.74#########################################################################
DATA,116,"Command update period",1,2,0x10,2
	"Select the update period of command by the host controller in the network interface."
	"1: 0.5ms"
	"2: 1ms"
	"Note that this is not the communication period, which is fixed at 0.5ms."
#N0.75#########################################################################
