############################################
#Input terminals
############################################
IN MENU,31
DATA,0X0,"+A Servo ON",                  " - Servo ON"
DATA,0x1," -",                           " -"
DATA,2,  "+A CW overtravel",             " - CW overtravel"
DATA,3,  "+A CCW overtravel",            " - CCW overtravel"
DATA,4,  "+A Home input",                " - Home input"
DATA,5,  "+A EX-IN1",                    " - EX-IN1"
DATA,6,  "+A EX-IN2",                    " - EX-IN2"
DATA,7,  "+A EX-IN3",                    " - EX-IN3"
DATA,8,  " -",                           " -"
DATA,9,  " -",                           " -"               #EX-IN5
DATA,10, " -",                           " -"               #EX-IN6
DATA,11, " -",                           " -"
DATA,12, " -",                           " -"
DATA,13, " -",                           " -"
DATA,14, " -",                           " -"
DATA,15, "+A Emergency stop",            " - Emergency stop"
DATA,16, " -",                           " -"
DATA,17, " -",                           " -"
DATA,18, "+A Homing Ctrl",               " - Homing Ctrl"
DATA,19, "+A TL SW",                     " - TL SW"
DATA,20, "+A Gain SW",                   " - Gain SW"
DATA,21, " -",                           " -"
DATA,22, " -",                           " -"
DATA,23, "+A Servo ON",                  " - Servo ON"
DATA,24, "+A EX-OUT1",                   " - EX-OUT1"
DATA,25, "+A EX-OUT2",                   " - EX-OUT2"
DATA,26, " -",                           " -"
DATA,27, " -",                           " -"
DATA,28, " -",                           " -"
DATA,29, " -",                           " -"
DATA,30, " -",                           " -"
DATA,31, " -",                           " -"
END
############################################
#Output terminal
############################################
"OUT MENU",31
DATA,0, " -",                           " -"
DATA,1, "+A Servo alarm",               " - Servo alarm"
DATA,2, " -",                           " -"
DATA,3, "+A Brake release",             " - Brake release"
DATA,4, " -",                           " -"             #Zero speed detected
DATA,5, " -",                           " -"             #Torque limited
DATA,6, " -",                           " -"             #Within speed window
DATA,7, "+A EX-OUT1",                   " - EX-OUT1"
DATA,8, "+A EX-OUT2",                   " - EX-OUT2"
DATA,9, " -",                           " -"             #At-speed
DATA,10," -",                           " -"             #Full closed in-position
DATA,11," -",                           " -"
DATA,12," -",                           " -"
DATA,13,"+A Dynamic brake action",      " - Dynamic brake action"
DATA,14," -",                           " -"
DATA,15," -",                           " -"
DATA,16, "+A In Position",              " - In Position"
DATA,17, " -",                          " -"
DATA,18, "+A Homing Complete",          " - Homing Complete"
DATA,19, "+A Torque Limited",           " - Torque Limited"
DATA,20, "+A Warning",                  " - Warning"
DATA,21, "+A Alarm",                    " - Alarm"
DATA,22, "+A Servo Ready",              " - Servo Ready"
DATA,23, "+A Servo Active",             " - Servo Active"
DATA,24, "+A CWL",                      " - CWL"
DATA,25, "+A CCWL",                     " - CCWL"
DATA,26, "+A Home",                     " - Home"
DATA,27, "+A EX-IN1",                   " - EX-IN1"
DATA,28, "+A EX-IN2",                   " - EX-IN2"
DATA,29, "+A EX-IN3",                   " - EX-IN3"
DATA,30, "+A EX-SON / EX-IN4",          " - EX-SON / EX-IN4"
DATA,31, "+A EMG-STP",                  " - EMG-STP"
END
############################################
#Absolute encoder status bit
############################################
ABSO MENU,15
DATA,0,Overspeed, -
DATA,1,Full absolute status, -
DATA,2,Counter error, -
DATA,3,Counter overflow, -
DATA,4,-,-
DATA,5,Multi-turn error, -
DATA,6,Battery error, -
DATA,7,Battery alarm,-
DATA,8,-,-
DATA,9,-,-
DATA,10,-,-
DATA,11,-,-
DATA,12,Battery error, -
DATA,13,Error, -
DATA,14,-,-
DATA,15,-,-
END
