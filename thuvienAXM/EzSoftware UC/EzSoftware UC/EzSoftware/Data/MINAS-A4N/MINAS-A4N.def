############################################
# Cautions at auto tuning
############################################
"AUTO MESSAGE",7
DATA,0,"1. Motor and load that are applicable to this auto tuning are limited."
DATA,1,"Check up the specifications."
DATA,2,"2. Set Pr.03(Torque limit selection) to 1 in advance."
DATA,3,"During auto tuning, the torque limit is set to maximum output torque."
DATA,4,"3. Drive may enter the oscillation state depending on the load. Pay extra attention."
DATA,5,"Once in oscillation, turn to servo-off (EX-SON open) immediately,"
DATA,6,"and return the gains to the original value with the parameter set-up."
DATA,7,"4. Read the specifications carefully before executing the auto tuning."
#
#Operation
#
DATA,9,"After setting Mechanical stiffness, click <Execute>."
#
#Cautions on frequency characteristics measurement
#
DATA,10,"- Motor speed varies intensely. Pay extra attention to the safety."
DATA,11,"- For the worst case, measure so that you can turn to servo-off immediately."
DATA,12,"- If the machine may be breakdown due to the hard motion, do not use this function."
DATA,13,"- Measure with as low gain as possible."
DATA,14,"- Larger offset may make the machine move exceeding the limit. Pay extra attention."
DATA,15,""
DATA,16,"If you need a help on measurement condition, click the <Help> button."
DATA,17,"After setting the measurement condition, click the <Execute the measurement> button."
DATA,18,""
DATA,19,""
#
#Monitor screen
#
DATA,20,"This indicates Actual Position of the external scale. This data has the polarity that CCW is positive."
DATA,21,"When the load rate exceeds 100%, alarm may occur. Adjust the motion pattern so as not to exceed 100%."
DATA,22,"This indicates the load of the regenerative discharge resistor, and does not indicate the regenerative power."
DATA,23,"This indicates Command Position. This data has the polarity that CCW is positive."
DATA,24,"This indicates Actual Position of the encoder. This data has the polarity that CCW is positive."
DATA,25,"In the full-closed control, the drive makes this error zero. Another position error on the right side display is not used."
DATA,26,""
DATA,27,""
DATA,28,""
DATA,29,""
#
#Parameter screen
#
DATA,30,"You can change the set-up value by pressing the Enter-key or clicking <Change of the setting value> button after entering the value."
DATA,31,""
DATA,32,""
DATA,33,""
DATA,34,""
END
############################################
#Color of each line of the graph
############################################
"GRAPH DATA",1
DATA,0
	0		,# Speed
	16711680	,# Torque
	255		,# Error
	16711935	,# Commanded speed
END
############################################
#Control Mode
############################################
CTRL MODE MENU,7			,#「新規追加」
DATA,0,"Position"			,#「新規追加」
DATA,1,"Velocity"			,#「新規追加」
DATA,2,"Torque"				,#「新規追加」
DATA,3,"Full-closed"		,#「新規追加」
DATA,4,""					,#「新規追加」
DATA,5,""					,#「新規追加」
DATA,6,""					,#「新規追加」
DATA,7,""					,#「新規追加」
DATA,8,""					,#「新規追加」
DATA,9,""					,#「新規追加」
DATA,10,""					,#「新規追加」
END
############################################
#Meaning of the error(which the driver send back) or bit of warning byte
############################################
BIT NAME EXT,0
DATA,0					,#at normal command
	8					,# 8
	"In-sampling, others"		,# bit 0
	"Servo alarm, others"		,# bit 1
	"Torque saturation, Servo-off, others"	,# bit 2
	"Number error"				,# bit 3
	"RS485 error"			,# bit 4
	"Command error"			,# bit 5
	"None definition error"		,# bit 6
	"Error bit ON"			,# bit 7
DATA,1					,# at auto tuning
	8					,#8
	"In-sampling, others"		,# bit 0
	"Servo alarm, others"		,# bit 1
	"Servo-off"				,# bit 2
	"Number error"				,# bit 3
	"RS485 error"			,# bit 4
	"Command error"			,# bit 5
	"None definition error"		,# bit 6
	"Error bit ON"			,# bit 7
DATA,2					,#at measuring frequency characteristics
	8					,#8
	"In-sampling, others"		,# bit 0
	"Servo alarm, others"		,# bit 1
	"Servo-off"				,# bit 2
	"Number error"				,# bit 3
	"RS485 error"			,# bit 4
	"Command error"			,# bit 5
	"None definition error"		,# bit 6
	"Error bit ON"			,# bit 7
DATA,10					,#when warning is displayed on the monitor screen
	16					,#16
	"Battery warning"		,# bit0
	"Undefined"				,# bit1
	"Undefined"				,# bit 2
	"Undefined"				,# bit 3
	"Undefined"				,# bit 4
	"Regeneration warning"	,# bit 5
	"FAN-locked warning"	,# bit 6
	"Overload warning"		,# bit 7
	"External scale warning",# bit 8
	"Continuous COM warning",# bit 9
	"Cumulative COM warning",# bit 10
	"Update Counter warning",# bit 11
	"Undefined"				,# bit 12
	"Undefined"				,# bit 13
	"Undefined"				,# bit 14
	"Undefined"				,# bit 15
END
############################################
#Parameters displayed at auto tuning
############################################
AUTO PARA,7			
#1: display 0: non-display
DATA,0,1, 1st pos. loop gain:,0X10
DATA,1,1, 1st vel. loop gain:,0X11
DATA,2,1, 1st vel. integration time:,0X12
DATA,3,1, 1st spd. detection filter:,0X13
DATA,4,1, 1st trq. filter time:,0X14
DATA,5,1, Inertia ratio:,0X20
DATA,6,0, unused:,0X15
END
############################################
#Control mode which displays the full close pages
############################################
FULL CLOSE ENABLE MODE,7			
DATA,3,1	,# Full close page displayed at mode 3
DATA,4,1	,# Full close page displayed at mode 4
DATA,5,1	,# Full close page displayed at mode 5
DATA,6,1	,# Full close page displayed at mode 6
DATA,10,1	,# Full close page displayed at mode 10
END
