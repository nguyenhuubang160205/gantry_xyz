    LTEXT           "",IDC_STATIC,49,151,179,43,SS_SUNKEN
    LTEXT           "http://www.ajinextek.com",IDC_AJINEXTEK,89,120,94,8
END

IDD_AO_TEST_DIALOG DIALOGEX 0, 0, 475, 185
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "AO_TEST"
FONT 9, "Arial"
BEGIN
    DEFPUSHBUTTON   "EXIT(&X)",IDOK,409,150,50,20
    COMBOBOX        IDC_COMBO_Module,117,6,218,57,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    CONTROL         "List1",IDC_LIST_AOCHANNEL,"SysListView32",LVS_REPORT | 
                    LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,7,25,328,151
    CTEXT           "Module No ◈ Board No ◈ Name",IDC_STATIC,7,6,106,11,
                    SS_CENTERIMAGE
    GROUPBOX        "Setting",IDC_STATIC,345,6,123,171
    LTEXT           "Wave",IDC_STATIC,352,25,47,13,SS_CENTERIMAGE
    COMBOBOX        IDC_COMBO_WAVE,409,25,53,57,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_EDIT_PERIOD,409,43,53,14,ES_RIGHT | ES_AUTOHSCROLL
    CONTROL         "Spin1",IDC_SPIN_PERIOD,"msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | 
                    UDS_ARROWKEYS | UDS_NOTHOUSANDS,442,43,9,14
    LTEXT           "Periodic(ms)",IDC_STATIC,352,43,47,13,SS_CENTERIMAGE
    LTEXT           "Voltage range",IDC_STATIC,352,63,47,13,SS_CENTERIMAGE
    COMBOBOX        IDC_COMBO_VRANGE,409,63,53,57,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    LTEXT           "Sample Gap(ms)",IDC_STATIC,352,81,54,13,SS_CENTERIMAGE
    COMBOBOX        IDC_COMBO_GAP,409,81,53,74,CBS_DROPDOWNLIST | WS_VSCROLL | 
                    WS_TABSTOP
    LTEXT           "Voltage",IDC_STATIC,352,99,47,13,SS_CENTERIMAGE
    PUSHBUTTON      "START(&S)",IDC_BUTTON_START,352,150,50,20
    EDITTEXT        IDC_EDIT_VOLTAGE,409,99,53,14,ES_RIGHT | ES_AUTOHSCROLL
    CONTROL         "Spin1",IDC_SPIN_VOLTAGE,"msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | 
                    UDS_ARROWKEYS,453,101,9,14
