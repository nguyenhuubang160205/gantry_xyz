                    WS_EX_CLIENTEDGE
    LTEXT           "본사           전화 : (053) 593-3700, 팩스 : (053) 593-3703",
                    IDC_STATIC_TEL1,49,94,179,8
    LTEXT           "서울사무소  전화 : (031) 389-1580, 팩스 : (031) 389-1583",
                    IDC_STATIC_TEL2,49,107,179,8
    LTEXT           "홈페이지",IDC_STATIC_HOMEPAGE,49,120,35,8
    LTEXT           "이 제품은 다음 사용자에게 허가 되었습니다.",
