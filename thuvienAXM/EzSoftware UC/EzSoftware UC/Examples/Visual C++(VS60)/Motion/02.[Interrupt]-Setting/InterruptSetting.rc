IDD_INTERRUPTSETTING_DIALOG DIALOGEX 0, 0, 273, 335
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "InterruptSetting"
FONT 9, "±¼¸²"
BEGIN
    COMBOBOX        IDC_CBO_SEL_AXIS,68,7,192,325,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    LTEXT           "Select Axis No : ",IDC_STATIC,13,9,54,11,SS_CENTERIMAGE
    GROUPBOX        "< Interrupt Event Bank 1 [0x00000000] >",IDC_GRP_BANK1,
                    7,27,259,82
    GROUPBOX        "< Interrupt Event Bank 2 [0x00000000] >",IDC_GRP_BANK2,
                    7,113,259,113
    CONTROL         "",IDC_STATIC,"Static",SS_GRAYFRAME,7,6,259,16
    CONTROL         "[Bit 00] When drive set interrupt occurrence use is exited",
                    IDC_CHK_BANK1_BIT_00,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,13,41,195,10
    CONTROL         "[Bit 01] When drive is exited",IDC_CHK_BANK1_BIT_01,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,56,107,10
    CONTROL         "[Bit 02] When drive started",IDC_CHK_BANK1_BIT_02,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,71,107,10
    CONTROL         "[Bit 31] Interrupt occurrence command execution",
                    IDC_CHK_BANK1_BIT_31,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,13,92,175,10
    CONTROL         "[Bit 14] UOut 0 terminal signal is changed to '1' (Servo On) ",
                    IDC_CHK_BANK2_BIT_14,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,13,126,210,10
    CONTROL         "[Bit 15] UOut 1 terminal signal is changed to '1' (Alarm Clear)",
                    IDC_CHK_BANK2_BIT_15,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,13,141,216,10
    CONTROL         "[Bit 16] UOut 2 terminal signal is changed to '1'",
                    IDC_CHK_BANK2_BIT_16,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,13,157,170,10
    CONTROL         "[Bit 20] UInput 0 terminal signal is changed to '1' (Home Signal)",
                    IDC_CHK_BANK2_BIT_20,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,13,178,223,10
    CONTROL         "[Bit 21] UInput 1 terminal signal is changed to '1' (Z-Phase Signal)",
                    IDC_CHK_BANK2_BIT_21,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,13,193,233,10
    CONTROL         "",IDC_STATIC,"Static",SS_GRAYFRAME,24,85,236,2
    CONTROL         "",IDC_STATIC,"Static",SS_GRAYFRAME,24,171,236,2
    PUSHBUTTON      "Set Bank 1",IDC_BTN_SET_BANK1,193,94,72,14
    GROUPBOX        "< Interrupt Method >",IDC_STATIC,7,231,181,28
    CONTROL         "Message",IDC_RDO_MESSAGE,"Button",BS_AUTORADIOBUTTON | 
                    WS_GROUP,13,243,46,10
    CONTROL         "Callback",IDC_RDO_CALLBACK,"Button",BS_AUTORADIOBUTTON,
                    83,243,41,10
    CONTROL         "Event",IDC_RDO_EVENT,"Button",BS_AUTORADIOBUTTON,146,
                    243,30,10
    CONTROL         "[Bit 22] UInput 2 terminal signal is changed to '1'",
                    IDC_CHK_BANK2_BIT_22,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,13,209,174,10
    LISTBOX         IDC_LST_INT_LOG,7,263,259,65,LBS_SORT | 
                    LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Interrupt Enable",IDC_CHK_INT_ENABLE,"Button",
                    BS_AUTOCHECKBOX | BS_PUSHLIKE | WS_TABSTOP,193,237,72,20
    PUSHBUTTON      "Set Bank 2",IDC_BTN_SET_BANK2,193,211,72,14
END


